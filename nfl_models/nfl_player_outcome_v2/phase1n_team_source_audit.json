  "semantics": {
    "attempts": "pass_attempt == 1 and sack == 0",
    "designed_rushes": "opportunity plays with rush_attempt == 1 that are not dropbacks/spikes (this is the RUSH ATTEMPT target; scrambles are kept separate)",
    "drives": "distinct (game_id, drive) among opportunity plays by the offense; fixed_drive reported as a sensitivity",
    "dropbacks": "opportunity plays with qb_dropback == 1 or qb_spike == 1 (sacks and scrambles are dropbacks; spikes are added because nflfastR records them with qb_dropback = 0)",
    "official_carries": "official team sum of stats_player_week carries (includes scrambles and kneels), used only to compare against the Phase1B carries layer",
    "opportunity_play": "play_type in {run, pass, qb_spike}, two_point_attempt == 0, qb_kneel == 0, and (qb_dropback or rush_attempt or qb_spike). Penalty/no-play rows, timeouts, punts, kicks and kneels are excluded. Kneels and two-point attempts are counted separately for the audit.",
    "overtime": "any play with qtr == 5",
    "plays": "dropbacks + designed_rushes (exact accounting; no other play class exists in the definition)",
    "scrambles": "qb_scramble == 1 (a subset of dropbacks, counted once as a play)",
    "targets": "official team sum of stats_player_week targets (downstream; reconciled to attempts in the audit)"
  },
